# FATO · configuración Apache (Hostinger y similares)
Options -Indexes
DirectoryIndex index.html

# Fuentes del generador: no se sirven al público
RedirectMatch 404 ^/(_src|tools)(/|$)

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType text/calendar .ics
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

# Caché: el HTML siempre fresco; CSS/JS llevan ?v=AAAAMMDD; imágenes largas
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

ErrorDocument 404 /index.html
